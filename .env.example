# Public application origin used for canonical URLs, OAuth callbacks, and webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project API URL. Local Supabase defaults to http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable/anonymous key; safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred modern server-only key (`sb_secret_...`). Never expose it to client components.
SUPABASE_SECRET_KEY=
# Optional legacy service-role JWT, supported for backward compatibility through 2026.
SUPABASE_SERVICE_ROLE_KEY=
# Google OAuth credentials configured in Supabase Auth; server-only.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Apple OAuth credentials configured in Supabase Auth; server-only.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Keep disabled until an Apple Developer account and valid credentials are available.
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=false
# SMS provider credentials configured in Supabase Auth for phone OTP.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
SUPABASE_AUTH_SMS_PROVIDER=
SUPABASE_AUTH_SMS_ACCOUNT_ID=
SUPABASE_AUTH_SMS_AUTH_TOKEN=
SUPABASE_AUTH_SMS_SENDER=
# Direct Postgres connection for Drizzle migrations and trusted server jobs.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Safety flag required by the destructive wallet concurrency test; use only on a disposable database.
WALLET_TEST_DATABASE=0
# Optional existing profile UUID used by the disposable wallet concurrency test.
WALLET_TEST_OWNER_ID=
# Safety flag and seeded order item for the destructive stock concurrency test.
FULFILLMENT_TEST_DATABASE=0
FULFILLMENT_TEST_ORDER_ITEM_ID=

# Optional deployed URL for Playwright; when omitted the test runner starts port 3100.
PLAYWRIGHT_BASE_URL=
# Domain used for randomized E2E signup addresses. Use a deliverable test domain in CI.
# Optional E2E address pattern. Resend's delivered+ labels safely simulate delivery.
PLAYWRIGHT_TEST_EMAIL_PATTERN=delivered+nexora-e2e-{locale}-{timestamp}@resend.dev

# Field-level encryption key for sensitive provider payloads and PII.
APP_ENCRYPTION_KEY=
# HMAC secret used for internal job/event signing.
INTERNAL_SIGNING_SECRET=
# Turnstile bot-protection credentials.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt used to pseudonymize anonymous consent records; at least 32 random bytes.
CONSENT_HASH_SALT=
# Upstash rate-limit storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe card payment adapter.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NOWPayments crypto adapter.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Optional future official Whish API adapter.
WHISH_API_BASE_URL=
WHISH_API_KEY=
# Optional local card gateway adapter: stripe, areeba, netcommerce, or checkout.
CARD_PAYMENT_PROVIDER=stripe
# Webhook signing secret when CARD_PAYMENT_PROVIDER uses the local gateway stub.
LOCAL_CARD_GATEWAY_WEBHOOK_SECRET=
# Legacy proof OCR variables are no longer used; proof analysis runs through the AI provider below.

# Resend transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Secret bearer token used by scheduled abandoned-cart recovery calls.
CRON_SECRET=

# At least 32 random characters; encrypts delivered codes/text/links at application level.
ORDER_PAYLOAD_ENCRYPTION_KEY=
# Standard Webhooks secret generated when configuring the Supabase Auth Send Email Hook.
SEND_EMAIL_HOOK_SECRET=
# WhatsApp Cloud API notifications.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Telegram bot notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# VAPID credentials for Web Push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Encryption and stable hashing for linked notification destinations.
NOTIFICATION_CONNECTION_ENCRYPTION_KEY=
NOTIFICATION_HASH_SALT=
# Optional SMS adapter implementing POST {to,message} -> {id}.
SMS_ADAPTER_ENDPOINT=
SMS_ADAPTER_TOKEN=

# AI provider abstraction used by RAG, translation, proof OCR, recommendations, and insights.
# Set AI_PROVIDER=disabled to keep every non-AI store feature operational without external calls.
AI_PROVIDER=disabled
# OpenAI-compatible endpoint and credentials. OPENAI_API_KEY remains a supported key alias.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_VISION_MODEL=gpt-4.1-mini
# Provider timeout and per-authenticated-user feature limit.
AI_TIMEOUT_MS=12000
AI_RATE_LIMIT_PER_HOUR=30
# Provider price in your billing currency's minor units per one million tokens.
# Keep both at 0 when cost accounting is not configured.
AI_INPUT_COST_PER_MILLION_MINOR=0
AI_OUTPUT_COST_PER_MILLION_MINOR=0
# Sentry error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ENV=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Analytics and consent-gated marketing pixels.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional generic SMM supplier.
SMM_PROVIDER_BASE_URL=
SMM_PROVIDER_API_KEY=
# Optional generic reseller supplier.
RESELLER_PROVIDER_BASE_URL=
RESELLER_PROVIDER_API_KEY=
# At least 32 random characters; encrypts supplier API credentials stored in Postgres.
# Falls back to APP_ENCRYPTION_KEY when omitted.
SUPPLIER_CREDENTIALS_ENCRYPTION_KEY=

# Encrypts reseller API and webhook signing secrets; generate a dedicated 32-byte random value.
# Falls back to APP_ENCRYPTION_KEY when omitted.
RESELLER_API_ENCRYPTION_KEY=
# Referral cookies and PII-safe fraud hashes (generate separate random values, at least 32 bytes).
REFERRAL_COOKIE_SECRET=
REFERRAL_HASH_SALT=
